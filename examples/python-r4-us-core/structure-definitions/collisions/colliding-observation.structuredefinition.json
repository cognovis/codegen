      {
        "id": "Observation.component:alleleDatabase.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [{ "system": "http://example.org/fhir/python/CodeSystem/synthetic", "code": "first" }]
        }
      },
      {
        "id": "Observation.component:allele_database",
        "path": "Observation.component",
        "sliceName": "allele_database",
        "min": 0,
        "max": "1"
      },
      {
        "id": "Observation.component:allele_database.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [{ "system": "http://example.org/fhir/python/CodeSystem/synthetic", "code": "second" }]
        }
      }
    ]
  }
