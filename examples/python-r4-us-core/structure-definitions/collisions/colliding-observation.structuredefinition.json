        "slicing": { "discriminator": [{ "type": "pattern", "path": "code" }], "rules": "open" }
      },
      {
        "id": "Observation.component:alleleDatabase",
        "path": "Observation.component",
        "sliceName": "alleleDatabase",
        "min": 0,
        "max": "1"
