  "version": "0.0.1",
  "name": "CollidingObservation",
  "status": "draft",
  "description": "Two component slices whose names snake-case to the same Python accessor.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
